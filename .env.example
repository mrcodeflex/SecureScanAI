# SecureScan AI configuration. install_windows.bat copies this file to ".env" for you.
# Lines starting with # are comments. Never commit your real .env file or share it.

# ---------------------------------------------------------------- network
# 127.0.0.1 = reachable from this computer only (safest default).
# 0.0.0.0   = reachable from other devices on your network (needed for the Android app).
#             Run allow_phone_access.bat instead of editing this by hand.
SSAI_HOST=127.0.0.1
SSAI_PORT=8000

# Plain HTTP on a trusted home/office network is allowed only when this is true.
# The server refuses to listen on the network over HTTP unless you set it (or configure TLS below).
SSAI_ALLOW_INSECURE_HTTP=false

# Optional TLS (HTTPS). Provide both files. Recommended for anything beyond a trusted LAN.
SSAI_SSL_CERTFILE=
SSAI_SSL_KEYFILE=

# Comma-separated browser origins allowed to call the API from another site (normally leave empty).
SSAI_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- storage and secrets
# Folder for the database, uploads and the generated secret key. Default: ./data
SSAI_DATA_DIR=
# SQLite is used by default. For PostgreSQL later, e.g. postgresql+psycopg://user:pass@host/dbname
SSAI_DATABASE_URL=
# 64+ random characters used to protect session tokens. Leave empty to auto-generate data/.secret_key
SSAI_SECRET_KEY=

# ---------------------------------------------------------------- accounts and sessions
SSAI_SESSION_MINUTES=480
SSAI_LOGIN_MAX_ATTEMPTS=5
SSAI_LOGIN_WINDOW_SECONDS=900
SSAI_SCANS_PER_MINUTE=10

# ---------------------------------------------------------------- scanning policy
# DEVELOPMENT ONLY: allow scanning localhost/private addresses. Keep false in normal use (SSRF protection).
SSAI_ALLOW_PRIVATE_TARGETS=false
# true = even passive website scans must target a host on the authorization allowlist.
SSAI_REQUIRE_ALLOWLIST_FOR_ALL=false
SSAI_HTTP_TIMEOUT=10
SSAI_MAX_REQUESTS_PER_SCAN=120
SSAI_REQUEST_DELAY_MS=150
SSAI_MAX_CONCURRENT_SCANS=2
SSAI_SCAN_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------- source ZIP limits
SSAI_MAX_UPLOAD_MB=50
SSAI_MAX_EXTRACT_MB=200
SSAI_MAX_FILES=5000
SSAI_MAX_FILE_KB=1024
SSAI_MAX_ZIP_RATIO=100

# ---------------------------------------------------------------- optional engines (see docs/ENGINES.md)
SSAI_SEMGREP_CONFIG=p/default
SSAI_SEMGREP_TIMEOUT=300
SSAI_TRIVY_TIMEOUT=300
# Sends exact package names and versions to api.osv.dev to find known vulnerabilities. Off by default (privacy).
SSAI_ENABLE_OSV=false
# OWASP ZAP in daemon mode, for example http://127.0.0.1:8090
SSAI_ZAP_URL=
SSAI_ZAP_API_KEY=
SSAI_ZAP_TIMEOUT=600

SSAI_LOG_LEVEL=INFO
